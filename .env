# Gmail/IMAP Configuration
GMAIL_EMAIL=your-actual-email@gmail.com
GMAIL_PASSWORD=your-gmail-app-password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=RemotelyX
MONGODB_COLLECTION=job_postings

# Email Filtering
SENDER_EMAIL=jobs@remotelyx.com
SUBJECT_KEYWORD=RemotelyX

# File Paths
EXCEL_FILE_PATH=./data/remotelyx_jobs.xlsx

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/remotelyx.log